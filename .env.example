# Server
NODE_ENV=production
PORT=3000
APP_URL=https://infinityaicloudacademy.com
JWT_SECRET=replace-with-a-long-random-secret

# Hostinger MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_hostinger_db_user
DB_PASSWORD=your_hostinger_db_password
DB_NAME=your_hostinger_db_name
DB_CONNECTION_LIMIT=10

# Optional SMTP for password-reset emails
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@infinityaicloudacademy.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=Infinity AI Cloud Academy <your-email@infinityaicloudacademy.com>

# One-time local/SSH admin seed variables (do not commit real values)
ADMIN_EMAIL=admin@infinityaicloudacademy.com
ADMIN_PASSWORD=change-this-immediately
ADMIN_FULL_NAME=Infinity AI Admin

# Frontend only needs the relative API path in production
VITE_API_BASE_URL=/api
